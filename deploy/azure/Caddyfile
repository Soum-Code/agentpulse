# Terminates TLS for the public deployment and proxies to the dashboard's
# nginx, which in turn proxies /v1/ to the backend. Caddy obtains and renews
# the Let's Encrypt certificate itself; no cron job or manual step is needed.
#
# AGENTPULSE_SITE_ADDRESS must be the hostname that resolves to this machine.
# A certificate cannot be issued for a bare IP address, so a DNS name is
# required — on Azure the free *.cloudapp.azure.com name is enough.
#
# Reads (GET, HEAD) are public, except the API-key routes (the @keys block below). Every other
# method needs a password: nginx adds
# the server's AGENTPULSE_API_KEY to every /v1/ request, so without this check
# anyone on the internet could ingest, resolve alerts, mint keys and add dataset
# cases. AGENTPULSE_WRITE_USER and AGENTPULSE_WRITE_HASH (the output of
# `caddy hash-password`, never the password itself) reach Caddy from .env through
# the compose file.
#
# Two writes are public on purpose.
#
# 1. /chat*, the live chat (the `chat` compose service, demo/chat_server.py). It reaches
#    that service and nothing else, and the service limits it itself: turns per IP per
#    minute and per day, a daily cap for the site, a maximum question length and a kill
#    switch (deploy/azure/README.md, "The live chat"). If the chat container is not
#    running, /chat* answers 502 and the rest of the site is unaffected: Caddy looks the
#    name up per request, not at start.
#
# 2. POST /v1/simulate, the Telemetry Lab's "Run scenario". Exactly that method and that
#    path, nothing else. Unlike the chat it goes through the dashboard's nginx, which adds
#    the server's AGENTPULSE_API_KEY, so the backend limits it itself: runs per IP per hour
#    and per day, a daily cap for the site and a refusal when the evaluation queue is deep
#    (backend/app/services/simulate_guard.py; deploy/azure/README.md, "Telemetry Lab").
#    It writes only demo traces under one fixed service name. To close it again, delete
#    its line in the @write block below and recreate Caddy.
#
# Unset, AGENTPULSE_WRITE_USER and AGENTPULSE_WRITE_HASH fall back to the placeholders
# below (the compose file does the same for an empty value). The placeholder hash matches no password, so every write
# is refused with 401, reads keep working and Caddy still starts: a missing value
# must not take the whole site down. It has to stay valid base64, though; Caddy
# refuses to start on anything else.
{$AGENTPULSE_SITE_ADDRESS} {
	encode gzip

	@write {
		not method GET HEAD
		# A write that must stay public gets a line here. Lines in this block are
		# ANDed, so a request is checked for a password only if every one of them
		# matches. The chat's line uses the same matcher as its handle block below,
		# so whatever skips the password goes to the chat service and only there.
		not path /chat*
		# The Telemetry Lab's line. It is an `expression`, not `path /v1/simulate`, on purpose:
		# `path` ignores letter case, merges double slashes and resolves "." and ".." before it
		# compares, and it does not look at the method. Tried against this file with
		# check_caddy_paths.sh, that let PUT, PATCH and DELETE on the path, /v1//simulate,
		# /V1/simulate and /v1/x/../simulate skip the password. {http.request.uri.path} is the
		# path as it arrived (percent-escapes decoded, nothing merged or resolved), so the two
		# == match POST and exactly /v1/simulate and nothing else.
		not expression `{http.request.method} == 'POST' && {http.request.uri.path} == '/v1/simulate'`
	}
	basic_auth @write bcrypt "AgentPulse writes" {
		{$AGENTPULSE_WRITE_USER:writes-disabled} {$AGENTPULSE_WRITE_HASH:ZGlzYWJsZWQ=}
	}

	# The API-key routes are closed to readers too. In short: a path with a segment that is
	# exactly "keys" (/v1/keys, /v1/keys/7, ...) asks for the write password whatever the
	# method, GET and HEAD included. Why: nginx adds the server's AGENTPULSE_API_KEY to every
	# /v1/ request, so a public GET /v1/keys?owner_id=<id> was answered as if the master key
	# had asked, and listed that owner's keys (id, label, key prefix, dates). The match is an
	# `expression` on {http.request.uri.path} for the same reason as the Telemetry Lab line
	# above: `path` ignores case and merges slashes. The regex is case-insensitive and looks
	# for a "keys" segment anywhere in the path, so /V1/keys, //v1/keys, /v1//keys, /v1/./keys,
	# /v1/x/../keys, /v1/KEYS, /v1/%6beys (decoded to "keys" before it is compared) and
	# /v1/keys/ all ask for the password. The backend routes only /v1/keys and /v1/keys/<id>
	# (tests/test_caddyfile_keys.py shows that the other spellings are 404 there), and both
	# have such a segment. A longer name does not match, so an agent called "turkeys" or a file
	# called keys-abc.js is still a public read. Same user and hash as above, so one password
	# opens both.
	@keys {
		expression `{http.request.uri.path}.matches('(?i)(^|/)keys(/|$)')`
	}
	basic_auth @keys bcrypt "AgentPulse writes" {
		{$AGENTPULSE_WRITE_USER:writes-disabled} {$AGENTPULSE_WRITE_HASH:ZGlzYWJsZWQ=}
	}

	# The live chat. A question is at most a few hundred characters, so a body over
	# 16 KB is refused (413) before it reaches the service. flush_interval -1 passes
	# each line of POST /chat/stream on as soon as it arrives, instead of buffering
	# the stream until the turn is over.
	handle /chat* {
		request_body {
			max_size 16KB
		}
		reverse_proxy chat:8100 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy dashboard:5173
	}
}
