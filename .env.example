# AgentPulse Configuration
# Copy this file to .env and fill in values

# Backend
AGENTPULSE_HOST=0.0.0.0
AGENTPULSE_PORT=8000
AGENTPULSE_DATABASE_URL=sqlite+aiosqlite:///./data/agentpulse.db
AGENTPULSE_API_KEY=change-me-to-a-secure-key
AGENTPULSE_LOG_LEVEL=INFO

# Evaluator
AGENTPULSE_NLI_MODEL=cross-encoder/nli-deberta-v3-small
AGENTPULSE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AGENTPULSE_MODEL_CACHE_DIR=./models
AGENTPULSE_USE_ONNX=true

# Drift
AGENTPULSE_DRIFT_WINDOW_SIZE=100
AGENTPULSE_DRIFT_THRESHOLD=0.3
AGENTPULSE_ASI_LOW_THRESHOLD=50

# Alerts
AGENTPULSE_HALLUCINATION_THRESHOLD=0.7
AGENTPULSE_ALERT_COOLDOWN_SECONDS=900
AGENTPULSE_ALERT_MAX_PER_HOUR=50
AGENTPULSE_WEBHOOK_URL=

# Privacy
AGENTPULSE_CAPTURE_INPUTS=false
AGENTPULSE_CAPTURE_OUTPUTS=false
AGENTPULSE_RETENTION_DAYS=30

# Public deployment (only read by deploy/azure/docker-compose.azure.yml)
# The hostname Caddy should request a TLS certificate for. A certificate
# cannot be issued for a bare IP, so this must be a DNS name pointing here.
AGENTPULSE_SITE_ADDRESS=

# Dashboard
# Read only by docker compose, which bakes it into the SPA bundle at build time.
# Leave it empty: the browser then requests /v1/... from whatever origin served
# the page and nginx proxies that to the backend container. An absolute URL here
# points every visitor's browser at their own machine instead of the server.
# (`npm run dev` has no such proxy, so dashboard/.env sets the address there.)
VITE_API_URL=
VITE_API_KEY=change-me-to-a-secure-key
